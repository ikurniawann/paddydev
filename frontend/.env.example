# Contoh konfigurasi env. Salin ke .env.local untuk development; jangan isi
# nilai asli di file ini. Di server, isi yang sama disimpan di CI variable
# RUNTIME_CONFIG_CONTENT (lihat README, bagian Environment Variables).
# Validasi saat boot: src/lib/env.ts. Variabel NEXT_PUBLIC_* di-inline saat
# `next build`, jadi perubahan nilainya butuh build ulang.

# ── Database (WAJIB) ──────────────────────────────────────────────────────
# Koneksi aplikasi. Bila kosong, MIGRATE_DATABASE_URL dipakai sebagai cadangan;
# tanpa keduanya server berhenti saat boot.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arkiv
# Target migrasi dan seeder (npm run db:migrate*, db:seed:*).
MIGRATE_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/arkiv

# ── Backend Go (opsional) ─────────────────────────────────────────────────
# Origin service Go (backend/), mis. http://localhost:8080. Bila diisi, path
# /api yang terdaftar di src/lib/backend-routes.ts diteruskan ke sana; kosong =
# semua /api dilayani Next.
BACKEND_URL=

# ── URL publik & identitas ────────────────────────────────────────────────
# Origin publik untuk tautan absolut (redirect pembayaran, link WA, email,
# webhook). Kosong = origin request; job latar menulis tautan relatif.
NEXT_PUBLIC_APP_URL=
# Host lama ke origin baru, dipisahkan koma. Berlaku untuk GET/HEAD; path dan query dipertahankan.
# Contoh: old.example.com=https://paddy.example.com,member.old.example.com=https://member.paddy.example.com
# (nama lama MIZU_LEGACY_HOST_REDIRECTS tetap dibaca sebagai cadangan)
PADDY_LEGACY_HOST_REDIRECTS=
# Host staf yang root domain-nya (/) langsung ke /login, bukan situs publik. Dipisah koma, tanpa skema/port.
# Contoh: paddydev.reddie.id. Kosong = semua host menampilkan situs publik di /.
PADDY_LOGIN_ROOT_HOSTS=
# Nama lama NEXT_PUBLIC_APP_URL; masih dibaca sebagai cadangan. Jangan dipakai lagi.
# NEXT_PUBLIC_BASE_URL=
NEXT_PUBLIC_APP_NAME=
# Bridge NFC kasir (ws://...), dan saklar fitur shift POS ("true"/"false").
NEXT_PUBLIC_POS_NFC_BRIDGE_WS=
NEXT_PUBLIC_POS_SHIFT_MANAGEMENT_ENABLED=

# ── Email (Resend) ────────────────────────────────────────────────────────
# Tanpa kunci: email tidak dikirim (satu peringatan di log).
RESEND_API_KEY=
FROM_EMAIL=
DATAROOM_FROM_EMAIL=
# Penerima notifikasi lamaran kerja dari portal karier.
HRD_EMAIL=

# ── Pembayaran Xendit ─────────────────────────────────────────────────────
XENDIT_SECRET_KEY=
# Token callback dari dashboard Xendit; webhook ditolak tanpa nilai ini.
XENDIT_WEBHOOK_TOKEN=
XENDIT_API_BASE_URL=
# "1" = simulasi tanpa Xendit (ditolak di production).
XENDIT_MOCK=

# ── WhatsApp ──────────────────────────────────────────────────────────────
# meta | gateway | fonnte; kosong = deteksi otomatis dari kredensial.
WHATSAPP_PROVIDER=
META_WA_ACCESS_TOKEN=
META_WA_PHONE_NUMBER_ID=
META_WA_GRAPH_VERSION=
META_WA_OTP_TEMPLATE=
META_WA_OTP_LANG=
META_WA_OTP_BUTTON=
# Gateway WA mandiri; nilai di Settings → WhatsApp Gateway menang atas env.
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=
WA_GATEWAY_TIMEOUT_MS=
FONNTE_API_KEY=

# ── Portal member ─────────────────────────────────────────────────────────
# Web push; buat per lingkungan: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
# Kode OTP tetap untuk development dengan database lokal; diabaikan di production.
MEMBER_OTP_DEV_CODE=

# ── AI ────────────────────────────────────────────────────────────────────
# Bisa juga diisi dari Settings → Integrasi (nilai database menang).
OPENAI_API_KEY=
OPENAI_TIMEOUT=

# ── Google Business Profile & Instagram (cadangan bila Settings kosong) ───
GOOGLE_BP_CLIENT_ID=
GOOGLE_BP_CLIENT_SECRET=
GOOGLE_BP_REFRESH_TOKEN=
GOOGLE_BP_ACCOUNT_ID=
GOOGLE_BP_LOCATION_ID=
IG_APP_SECRET=
IG_VERIFY_TOKEN=
IG_ACCESS_TOKEN=
IG_ACCOUNT_ID=

# ── Toko online, kurir, marketplace ───────────────────────────────────────
BITESHIP_API_KEY=
BITESHIP_WEBHOOK_TOKEN=
RAJAONGKIR_API_KEY=
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_API_BASE=
# Token cron untuk POST /api/shop/marketplace/sync.
MARKETPLACE_SYNC_TOKEN=

# ── Modul lain ────────────────────────────────────────────────────────────
HRIS_HOLIDAY_ICS_URL=
DATAROOM_MAX_FILE_MB=
DATAROOM_QUOTA_GB=

# ── Print worker POS (scripts/pos-print-worker.mjs) ───────────────────────
# Token dibagi antara aplikasi dan worker printer.
POS_PRINT_WORKER_TOKEN=
PRINT_QUEUE_BASE_URL=http://localhost:3000
PRINT_QUEUE_STATION=
PRINT_QUEUE_INTERVAL_MS=

# ── Seeder & skrip database (tidak dibaca aplikasi) ───────────────────────
# Password akun seed. Kosong = password acak, dicetak sekali saat seeder jalan.
SUPER_USER_EMAIL=
SUPER_USER_PASSWORD=
SUPER_USER_NAME=
SUPER_USER_NIP=
SUPER_USER_PHONE=
DEMO_MIZU_EMAIL=
DEMO_MIZU_PASSWORD=
DEMO_MIZU_NAME=
DEMO_MIZU_NIP=
DEMO_MIZU_PHONE=
MIZU_STALL_PASSWORD=
MIZU_STALL_EMAIL_DOMAIN=
MIZU_STALL_BRANCH_CODE=
HRIS_SEED_PASSWORD=
MIZU_APPAREL_EMAIL=
MIZU_APPAREL_PASSWORD=
MIZU_APPAREL_OWNER_EMAIL=
MIZU_APPAREL_OWNER_PASSWORD=
MIZU_APPAREL_HOLDING_CODE=
MIZU_APPAREL_COMPANY_CODE=
MIZU_APPAREL_COMPANY_NAME=
MIZU_APPAREL_BRANCH_CODE=
MIZU_APPAREL_BRANCH_NAME=
DUSUN_BAMBU_EMAIL=
DUSUN_BAMBU_PASSWORD=
DUSUN_BAMBU_HOLDING_CODE=
DUSUN_BAMBU_COMPANY_CODE=
DUSUN_BAMBU_COMPANY_NAME=
DUSUN_BAMBU_BRANCH_CODE=
DUSUN_BAMBU_BRANCH_NAME=
SEED_HOLDING_CODE=
SEED_COMPANY_CODE=
SEED_BRANCH_CODE=
SEED_BRANCH_NAME=
RESORT_COMPANY_CODE=
RESORT_BRANCH_CODE=
# Seeder menolak database non-lokal kecuali "1" (atau --allow-remote).
ALLOW_REMOTE_DB=
# Konfirmasi reset destruktif di database remote (nilai: YES).
CONFIRM_REMOTE_HRIS_RESET=
CONFIRM_REMOTE_ITEMS_RESET=
CONFIRM_REMOTE_SUPPLIER_RESET=
CONFIRM_REMOTE_RAW_MATERIAL_COA=
# Introspeksi / salin data satu kali (database/scripts), audit menu (scripts/audit).
SOURCE_DATABASE_URL=
AUDIT_DATABASE_URL=
MIGRATIONS_DIR=
